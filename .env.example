# Same Neon database as Travola-OS and Travola Home. Pantry is a READER
# of the shared schema and a writer of ShiftSalesEntry only — it never
# runs `prisma migrate` or `db push`. Travola-OS owns every migration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&channel_binding=require"
# Must be BYTE-IDENTICAL to the SESSION_SECRET on Travola-OS and Travola Home.
SESSION_SECRET="<32+ random bytes, base64>"
