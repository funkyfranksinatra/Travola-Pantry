# Same Neon database as Travola-OS and Travola Home. Pantry is a READER
# of the shared schema and a writer of ShiftSalesEntry only — it never
# runs `prisma migrate` or `db push`. Travola-OS owns every migration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full&channel_binding=require"
# Must be BYTE-IDENTICAL to the SESSION_SECRET on Travola-OS and Travola Home.
SESSION_SECRET="<32+ random bytes, base64>"

# ── Weekly report email (optional — everything else works without it) ──
# From resend.com → API Keys. Free tier is plenty for weekly digests.
# Until this is set, Settings saves the address but nothing sends.
RESEND_API_KEY=""
# The From address once a sending domain is verified at Resend.
# Unset, digests go out as "Travola Pantry <onboarding@resend.dev>".
REPORT_FROM_EMAIL=""
# Any long random string. Vercel sends it as the Authorization bearer on
# cron invocations (vercel.json schedules Mondays 15:00 UTC); the weekly
# route accepts nothing else.
CRON_SECRET=""
# Where email links point. Unset, the production pantry domain is used.
APP_URL=""
